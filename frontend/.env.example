# Copy this file to ".env.local" (or set these in the hosting panel) before going live.
# Without SMTP_HOST and SMTP_USER, emails are NOT sent – they are only written to the server log.

# Email server (SMTP) for insurance requests, confirmations and contact messages
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address shown in emails (should belong to a domain with SPF/DKIM set up)
SMTP_FROM=no-reply@selbstfahrervermietversicherung.online

# Admin login security – set a long random value on the live server
# (otherwise a default value from the code is used, which is not secure)
ADMIN_SESSION_SECRET=
# Only used the very first time the database is created
ADMIN_INITIAL_PASSWORD=
